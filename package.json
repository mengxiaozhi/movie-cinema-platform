{
  "name": "movie-cinema-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
